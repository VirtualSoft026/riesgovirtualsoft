{
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/.venv/**",
      "**/__pycache__/**",
      "**/*.bat",
      "**/*.exe",
      "**/*.dll",
      "**/*.cmd",
      "**/*.ps1",
      "**/*.sh",
      "**/*.py",
      "**/*.pdf"
    ],
    "headers": [
      {
        "source": "**/*.@(html|json|js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  }
}
