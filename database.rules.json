{
  "rules": {
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'Admin')",
        "role": {
          ".validate": "root.child('users').child(auth.uid).child('role').val() === 'Admin' || !data.exists()"
        }
      }
    },
    "shift_reports": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "active_sessions": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "login_history": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "permissions": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
