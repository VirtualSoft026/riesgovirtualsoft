{
  "rules": {
    "users": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('approved').val() === true && (root.child('users').child(auth.uid).child('role').val() === 'Admin' || root.child('users').child(auth.uid).child('role').val() === 'Supervisor')",
      ".indexOn": [
        "role",
        "status",
        "approved",
        "email"
      ],
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || (root.child('users').child(auth.uid).child('approved').val() === true && (root.child('users').child(auth.uid).child('role').val() === 'Admin' || root.child('users').child(auth.uid).child('role').val() === 'Supervisor')))",
        ".write": "auth != null && ((root.child('users').child(auth.uid).child('approved').val() === true && root.child('users').child(auth.uid).child('role').val() === 'Admin') || (auth.uid === $uid && !data.exists() && newData.exists()))",
        "role": {
          ".validate": "root.child('users').child(auth.uid).child('role').val() === 'Admin' || newData.val() === 'Gestor'"
        },
        "approved": {
          ".validate": "root.child('users').child(auth.uid).child('role').val() === 'Admin' || newData.val() === false"
        },
        "status": {
          ".validate": "root.child('users').child(auth.uid).child('role').val() === 'Admin' || newData.val() === 'pending' || newData.val() === 'Activo' || newData.val() === 'Inactivo'",
          ".write": "auth != null && auth.uid === $uid && root.child('users').child(auth.uid).child('approved').val() === true && data.exists() && (newData.val() === 'Activo' || newData.val() === 'Inactivo')"
        }
      }
    },
    "shift_reports": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('approved').val() === true && (root.child('users').child(auth.uid).child('role').val() === 'Admin' || root.child('users').child(auth.uid).child('role').val() === 'Supervisor')",
      ".indexOn": [
        "gestor",
        "timestamp",
        "rol",
        "uid"
      ],
      "$report_id": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('approved').val() === true && (root.child('users').child(auth.uid).child('role').val() === 'Admin' || root.child('users').child(auth.uid).child('role').val() === 'Supervisor' || data.child('uid').val() === auth.uid)",
        ".write": "auth != null && root.child('users').child(auth.uid).child('approved').val() === true && (root.child('users').child(auth.uid).child('role').val() === 'Admin' || (!data.exists() && newData.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && data.child('uid').val() === auth.uid && newData.exists() && newData.child('uid').val() === auth.uid))",
        "uid": {
          ".validate": "newData.val() === auth.uid"
        }
      }
    },
    "permissions": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('approved').val() === true && (root.child('users').child(auth.uid).child('role').val() === 'Admin' || root.child('users').child(auth.uid).child('role').val() === 'Supervisor' || (query.orderByChild === 'uid' && query.equalTo === auth.uid))",
      ".indexOn": [
        "status",
        "gestor",
        "uid",
        "fecha",
        "tipo"
      ],
      "$perm_id": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('approved').val() === true && (root.child('users').child(auth.uid).child('role').val() === 'Admin' || root.child('users').child(auth.uid).child('role').val() === 'Supervisor' || data.child('uid').val() === auth.uid)",
        ".write": "auth != null && root.child('users').child(auth.uid).child('approved').val() === true && (root.child('users').child(auth.uid).child('role').val() === 'Admin' || root.child('users').child(auth.uid).child('role').val() === 'Supervisor' || (!data.exists() && newData.exists() && newData.child('uid').val() === auth.uid))",
        "uid": {
          ".validate": "root.child('users').child(auth.uid).child('role').val() === 'Admin' || root.child('users').child(auth.uid).child('role').val() === 'Supervisor' || newData.val() === auth.uid"
        },
        "status": {
          ".validate": "root.child('users').child(auth.uid).child('role').val() === 'Admin' || root.child('users').child(auth.uid).child('role').val() === 'Supervisor' || (!data.exists() && newData.val() === 'Pendiente')"
        },
        "approved": {
          ".validate": "root.child('users').child(auth.uid).child('role').val() === 'Admin' || root.child('users').child(auth.uid).child('role').val() === 'Supervisor' || (!data.exists() && newData.val() === false)"
        },
        "notified": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('approved').val() === true && root.child('permissions').child($perm_id).child('uid').val() === auth.uid && data.val() === false && newData.val() === true"
        }
      }
    },
    "announcements": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('approved').val() === true",
      ".indexOn": [
        "date",
        "author"
      ],
      "$announcement_id": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('approved').val() === true && root.child('users').child(auth.uid).child('role').val() === 'Admin'",
        "readBy": {
          "$reader_uid": {
            ".write": "auth != null && root.child('users').child(auth.uid).child('approved').val() === true && auth.uid === $reader_uid && !data.exists() && newData.exists()",
            ".validate": "newData.hasChildren(['readAt']) && newData.child('readAt').isString()"
          }
        }
      }
    },
    "active_sessions": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('approved').val() === true && (root.child('users').child(auth.uid).child('role').val() === 'Admin' || root.child('users').child(auth.uid).child('role').val() === 'Supervisor')",
      ".indexOn": [
        "status",
        "lastHeartbeat",
        "gestor",
        "email",
        "uid"
      ],
      "$session_id": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('approved').val() === true && (root.child('users').child(auth.uid).child('role').val() === 'Admin' || root.child('users').child(auth.uid).child('role').val() === 'Supervisor' || auth.uid === $session_id)",
        ".write": "auth != null && root.child('users').child(auth.uid).child('approved').val() === true && (root.child('users').child(auth.uid).child('role').val() === 'Admin' || auth.uid === $session_id)"
      }
    },
    "login_logs": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('approved').val() === true && (root.child('users').child(auth.uid).child('role').val() === 'Admin' || root.child('users').child(auth.uid).child('role').val() === 'Supervisor')",
      ".indexOn": [
        "timestamp",
        "email",
        "uid"
      ],
      "$log_id": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('approved').val() === true && (root.child('users').child(auth.uid).child('role').val() === 'Admin' || (!data.exists() && newData.exists() && newData.child('uid').val() === auth.uid))",
        "logoutTime": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('approved').val() === true && root.child('login_logs').child($log_id).child('uid').val() === auth.uid",
          ".validate": "!newData.exists() || newData.isNumber()"
        }
      }
    },
    "login_history": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('approved').val() === true && (root.child('users').child(auth.uid).child('role').val() === 'Admin' || root.child('users').child(auth.uid).child('role').val() === 'Supervisor')",
      "$hist_id": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('approved').val() === true && (root.child('users').child(auth.uid).child('role').val() === 'Admin' || (!data.exists() && newData.exists() && newData.child('uid').val() === auth.uid))"
      }
    },
    "logs": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('approved').val() === true && (root.child('users').child(auth.uid).child('role').val() === 'Admin' || root.child('users').child(auth.uid).child('role').val() === 'Supervisor')",
      ".indexOn": [
        "timestamp",
        "gestor",
        "assignedTo",
        "status",
        "type",
        "uid"
      ],
      "$log_id": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('approved').val() === true && !data.exists() && newData.exists() && newData.child('uid').val() === auth.uid"
      }
    },
    "taskCatalog": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('approved').val() === true",
      ".write": "auth != null && root.child('users').child(auth.uid).child('approved').val() === true && root.child('users').child(auth.uid).child('role').val() === 'Admin'"
    },
    "taskAssignments": {
      "$uid": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('approved').val() === true && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'Admin' || root.child('users').child(auth.uid).child('role').val() === 'Supervisor')",
        ".write": "auth != null && root.child('users').child(auth.uid).child('approved').val() === true && (root.child('users').child(auth.uid).child('role').val() === 'Admin' || root.child('users').child(auth.uid).child('role').val() === 'Supervisor')"
      }
    },
    "scheduleAssignments": {
      "$uid": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('approved').val() === true && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'Admin' || root.child('users').child(auth.uid).child('role').val() === 'Supervisor')",
        ".write": "auth != null && root.child('users').child(auth.uid).child('approved').val() === true && root.child('users').child(auth.uid).child('role').val() === 'Admin'"
      }
    },
    "teleworkAssignments": {
      "$uid": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('approved').val() === true && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'Admin' || root.child('users').child(auth.uid).child('role').val() === 'Supervisor')",
        ".write": "auth != null && root.child('users').child(auth.uid).child('approved').val() === true && root.child('users').child(auth.uid).child('role').val() === 'Admin'"
      }
    },
    "taskProgress": {
      "$uid": {
        "$date": {
          "$taskId": {
            ".read": "auth != null && root.child('users').child(auth.uid).child('approved').val() === true && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'Admin')",
            ".write": "auth != null && root.child('users').child(auth.uid).child('approved').val() === true && auth.uid === $uid && root.child('taskAssignments').child(auth.uid).child($date).exists()",
            ".validate": "newData.hasChildren(['status']) && (newData.child('status').val() === 'pending' || newData.child('status').val() === 'in_progress' || newData.child('status').val() === 'done') && !newData.hasChild('uid') && !newData.hasChild('setId') && !newData.hasChild('taskId')"
          }
        }
      }
    }
  }
}
